{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER; Database=YOUR_DATABASE; Trusted_Connection=True; TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ServiceImagesContainer": "images",
    "SasExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://YOUR_FRONTEND_DOMAIN"
    ]
  },
  "JwtSettings": {
    "Secret": "YOUR_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "ElsaBeautyClinic",
    "Audience": "ElsaBeautyClinic",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RefreshTokenPepper": "YOUR_SECURE_PEPPER_HERE"
  },
  "CommunicationServices": {
    "ConnectionString": "endpoint=YOUR_ACS_ENDPOINT;accesskey=YOUR_ACS_ACCESS_KEY",
    "Email": {
      "SenderAddress": "no-reply@yourdomain.com"
    },
    "Sms": {
      "FromPhoneNumber": "+46701234567"
    }
  },
  "Notifications": {
    "EnableEmail": true,
    "EnableSms": true,
    "BrandName": "Elsa Beauty",
    "BrandLogoUrl": "https://example.com/logo.png",
    "SupportEmail": "support@example.com",
    "AppBaseUrl": "https://example.com"
  },
  "Reminders": {
    "Enabled": true,
    "LeadTimeHours": 24,
    "PollIntervalMinutes": 5
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "Stripe": {
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET",
    "NoShowFeeAmount": 200,
    "Currency": "sek"
  },
  "AllowedHosts": "*"
}
